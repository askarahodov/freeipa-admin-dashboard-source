# DEVELOPMENT ONLY. Never use this profile for a shared or production deployment.
PORTAL_RUNTIME_PROFILE=development
PORTAL_IDENTITY_MODE=static
PORTAL_STATIC_IDENTITY=developer@localhost
PORTAL_STATIC_NAME=Local Developer
PORTAL_DEFAULT_ROLE=admin

# Required by the runtime. Generate a unique value before starting:
# openssl rand -hex 32
CONFIG_ENCRYPTION_KEY=replace-with-a-random-64-character-hex-key

# Optional local-only integration settings can be copied from .env.example as needed.
DEMO_MODE=true
