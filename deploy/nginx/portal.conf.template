# Render only the documented deployment placeholders; unrestricted envsubst would erase
# Nginx runtime variables such as $host, $request_uri and $remote_addr.
# envsubst '${PORTAL_UPSTREAM_HOST} ${PORTAL_SERVER_NAME} ${TLS_CERTIFICATE} ${TLS_CERTIFICATE_KEY} ${PORTAL_TRUSTED_PROXY_SECRET}' < deploy/nginx/portal.conf.template
# PORTAL_TRUSTED_PROXY_SECRET must never be supplied by or exposed to clients.
upstream portal_backend {
    server ${PORTAL_UPSTREAM_HOST}:3001;
    keepalive 32;
}

server {
    listen 80;
    server_name ${PORTAL_SERVER_NAME};
    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name ${PORTAL_SERVER_NAME};

    ssl_certificate ${TLS_CERTIFICATE};
    ssl_certificate_key ${TLS_CERTIFICATE_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:portal_tls:10m;
    ssl_session_timeout 1d;

    client_max_body_size 16m;
    client_body_timeout 30s;
    keepalive_timeout 65s;

    location / {
        proxy_pass http://portal_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Portal-Proxy-Secret ${PORTAL_TRUSTED_PROXY_SECRET};
        proxy_set_header Upgrade "";
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_request_buffering on;
        proxy_buffering on;
    }
}
