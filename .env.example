DASHBOARD_BIND_ADDRESS=127.0.0.1
DASHBOARD_PORT=3001

# Additional server-side protection for critical configuration endpoints.
# This does not replace local user authentication and RBAC.
ADMIN_TOKEN=replace-with-a-long-random-admin-token

# AES-256-GCM key for encrypted integration settings.
# This placeholder is intentionally invalid: generate a unique key with `openssl rand -hex 32`.
# Keep the active key separately from backups. Changing it without a migration makes existing
# encrypted settings, replay specifications, approval payloads and revision snapshots unreadable.
CONFIG_ENCRYPTION_KEY=replace-with-a-random-64-character-hex-key

# Run without real FreeIPA and XYOps calls.
DEMO_MODE=false

# Secure Docker/production default: interactive local portal authentication.
# On the first start with an empty portal_users table, the bootstrap administrator is created once.
# After that, changing these bootstrap variables never changes the existing administrator password or role.
PORTAL_IDENTITY_MODE=local
PORTAL_DEFAULT_ROLE=viewer
PORTAL_BOOTSTRAP_ADMIN_USERNAME=admin
PORTAL_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters
PORTAL_BOOTSTRAP_ADMIN_NAME=Local administrator
PORTAL_SESSION_TTL_HOURS=12

# Login brute-force client identity and inbound trusted-proxy proof.
# Safe default ignores forwarded address and scheme headers.
# Use `cloudflare` only when requests reach the Worker through the Cloudflare edge.
# Use `trusted-proxy` only when the reverse proxy removes any client-supplied
# X-Portal-Proxy-Secret / X-Forwarded-For / X-Forwarded-Proto values and sets its own
# X-Portal-Proxy-Secret together with X-Forwarded-For and one exact X-Forwarded-Proto
# value (`http` or `https`). Keep the secret server-side only. The trusted-proxy proof
# does not replace the default loopback bind, firewalling, or other network access control.
PORTAL_CLIENT_IP_SOURCE=none
# PORTAL_TRUSTED_PROXY_SECRET=replace-with-a-long-random-proxy-secret

# Node/Docker browser-security controls. CSP is enforcing by default; `report-only` is a
# temporary migration/debug mode, not a permanent production bypass. HSTS is opt-in and
# is emitted only when the effective request is authenticated as HTTPS by the trusted-proxy
# scheme contract. Enable HSTS only after the public hostname is permanently HTTPS.
PORTAL_CSP_MODE=enforce
PORTAL_HSTS_ENABLED=false

# Optional outbound HTTP(S) proxy for FreeIPA/XYOps traffic. Node built-in proxy support is
# enabled only with NODE_USE_ENV_PROXY=1 and requires Node.js 22.21.0+ on the Node 22 line
# (or Node.js 24.5.0+). When enabled, NO_PROXY/no_proxy MUST include 127.0.0.1 so the private
# FreeIPA Gateway bearer token never traverses a proxy. Proxy URLs may contain credentials:
# keep them only in the local/server-side environment.
# NODE_USE_ENV_PROXY=1
# HTTP_PROXY=http://proxy.company.local:8080
# HTTPS_PROXY=http://proxy.company.local:8080
# NO_PROXY=localhost,127.0.0.1,.company.local

# Do not use static identity for a shared or production deployment.
# For an isolated development workstation, start from .env.dev.example instead.

# Roles: viewer (read-only), operator (FreeIPA changes + XYOps launches),
# admin (deletions, approvals, audit, settings and RBAC).

# FreeIPA is an independent management module. Use a dedicated service account
# with only the user/group permissions exposed by the portal.
IPA_URL=https://ipa.company.local
IPA_USERNAME=portal-freeipa-manager
IPA_PASSWORD=change-me
IPA_VERIFY_TLS=true

# XYOps is optional for basic FreeIPA administration.
XYOPS_URL=https://xyops.company.local
XYOPS_API_KEY=change-me
XYOPS_EVENT_ID=freeipa-user-create

# Maximum declared Content-Length accepted by the output-file proxy (50 MiB).
XYOPS_RESULT_FILE_MAX_BYTES=52428800

# Automatic catalog synchronization.
XYOPS_CATALOG_SYNC_ENABLED=true
XYOPS_CATALOG_SYNC_LOCK_TTL_SECONDS=900

# Bootstrap routing profiles. Persisted routes from the database take priority.
XYOPS_ROUTES_JSON=[{"key":"user-create","title":"Создание пользователя","operation":"user_add","kind":"event","eventId":"freeipa-user-create","enabled":true,"targets":[],"fields":[{"key":"username","label":"Логин","type":"string","required":true,"target":"params"},{"key":"firstName","label":"Имя","type":"string","required":true,"target":"params"},{"key":"lastName","label":"Фамилия","type":"string","required":true,"target":"params"},{"key":"email","label":"Email","type":"string","target":"params"}]},{"key":"user-onboarding","title":"Полный onboarding","operation":"user_add","kind":"workflow","eventId":"freeipa-user-onboarding","enabled":true,"targets":[],"fields":[{"key":"username","label":"Логин","type":"string","required":true,"target":"params"},{"key":"department","label":"Отдел","type":"select","required":true,"target":"workflowData","options":["development","devops","security"]}]},{"key":"group-create","title":"Создание группы","operation":"group_add","kind":"event","eventId":"freeipa-group-create","enabled":true,"targets":[],"fields":[{"key":"group","label":"Группа","type":"string","required":true,"target":"params"},{"key":"description","label":"Описание","type":"string","target":"params"}]}]

# Catalog visibility policies. UI settings persist an override in the database.
# PORTAL_CATALOG_POLICIES_JSON={"version":1,"defaultEffect":"allow","adminBypass":true,"rules":[]}

# Dangerous processes require one independent admin by default.
# PORTAL_APPROVAL_POLICIES_JSON={"version":1,"dangerousDefaults":{"requiredApprovals":1,"approverRoles":["admin"],"approverGroups":[],"requesterCannotApprove":true,"expiresMinutes":60,"ruleId":"dangerous-default"},"rules":[]}

# Optional process presentation metadata.
PORTAL_PROCESS_METADATA_JSON={"version":1,"defaultLocale":"ru","processes":{"database-backup":{"title":"Резервное копирование БД","category":"Базы данных","icon":"backup","order":10,"locales":{"en":{"title":"Database backup","category":"Databases"},"en-GB":{"title":"Database backup (UK)"}}}}}
