{
  "name": "freeipa-admin-dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "start:docker": "node scripts/start-worker.mjs",
    "recovery": "node --experimental-strip-types scripts/portal-recovery.ts",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "test:recovery": "node --experimental-strip-types --test tests/recovery-*.test.mjs",
    "test:recovery:compose": "node scripts/recovery-compose-smoke.mjs",
    "test:integration:smoke": "node scripts/local-integration-smoke.mjs",
    "test:local": "bash scripts/run-local-integration.sh",
    "test:local-auth:acceptance": "node scripts/local-auth-acceptance.mjs",
    "test:p0:acceptance": "node scripts/p0-operational-acceptance.mjs",
    "test:e2e:auth": "bash scripts/run-auth-e2e.sh",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "security:audit": "node scripts/dependency-audit-policy.mjs",
    "security:sbom": "npm sbom --omit=dev --package-lock-only --sbom-format=cyclonedx",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "inspect:xyops": "node scripts/xyops-inspect.mjs",
    "inspect:storage": "node --experimental-strip-types scripts/storage-inspect.ts",
    "inspect:storage-integrity": "node --experimental-strip-types scripts/storage-integrity-inspect.ts",
    "inspect:storage-migration-preflight": "node --experimental-strip-types scripts/storage-migration-preflight-inspect.ts",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.8",
    "wrangler": "4.113.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.46.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5"
  },
  "overrides": {
    "sharp": "0.35.3",
    "undici": "7.29.0"
  },
  "type": "module",
  "displayName": "Admin Dashboard Softrust"
}

