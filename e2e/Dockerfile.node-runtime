FROM node:22-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

RUN useradd --system --uid 10001 dashboard \
 && mkdir -p /data \
 && chown dashboard:dashboard /data

USER dashboard
EXPOSE 3001

CMD ["node", "--experimental-strip-types", "scripts/start-node-e2e-runtime.mjs"]
